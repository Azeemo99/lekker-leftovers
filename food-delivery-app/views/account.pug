extends layout

block content
  .account-container
    h1 My Account
    
    if messages
      if messages.error
        .alert.alert-danger= messages.error
      if messages.success
        .alert.alert-success= messages.success

    .account-sections
      // Profile Section
      .profile-section
        h2 Profile Information
        form(method='POST' action='/account/update')
          .form-group
            label(for='username') Username
            input.form-control(
              type='text' 
              id='username' 
              name='username' 
              value=customer.username
              required
            )
          
          .form-group
            label(for='fname') First Name
            input.form-control(
              type='text' 
              id='fname' 
              value=customer.fname
              readonly
            )
          
          .form-group
            label(for='lname') Last Name
            input.form-control(
              type='text' 
              id='lname' 
              value=customer.lname
              readonly
            )
          
          .form-group
            label(for='phone') Phone Number
            input.form-control(
              type='text' 
              id='phone' 
              value=customer.phone_number
              readonly
            )
          
          // Password Change Fields
          h3 Change Password
          .form-group.password-group
            label(for='currentPassword') Current Password
            .password-input-container
              input.form-control(
                type='password'
                id='currentPassword'
                name='currentPassword'
                class='password-field'
              )
              button.toggle-password(type='button') 👁️
          
          .form-group.password-group
            label(for='newPassword') New Password
            .password-input-container
              input.form-control(
                type='password'
                id='newPassword'
                name='newPassword'
                class='password-field'
              )
              button.toggle-password(type='button') 👁️
          
          button.btn.btn-primary(type='submit') Update Account

      // Order History
      .order-history
        h2 Order History
        if orders.length > 0
          table.table
            thead
              tr
                th Date
                th Product
                th Supplier
                th Qty
                th Price
                th Total
                th Status
            tbody
              each order in orders
                tr
                  td= new Date(order.order_date).toLocaleString()
                  td= order.product_name
                  td= `${order.supplier_fname} ${order.supplier_lname}`
                  td= order.order_quantity
                  td £#{Number(order.price).toFixed(2)}
                  td £#{Number(order.total_price).toFixed(2)}
                  td
                    span.status(class=order.status.toLowerCase())= order.status
        else
          p.no-orders You haven't placed any orders yet.

      block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Get all toggle buttons and password fields
      const toggleButtons = document.querySelectorAll('.toggle-password');
      const passwordFields = document.querySelectorAll('.password-field');
      
      // Add click event to each toggle button
      toggleButtons.forEach((button, index) => {
        button.addEventListener('click', function() {
          // Toggle the password field type
          const type = passwordFields[index].getAttribute('type') === 'password' ? 'text' : 'password';
          passwordFields[index].setAttribute('type', type);
          
          // Change the eye icon
          this.textContent = type === 'password' ? '👁️' : '👁️‍🗨️';
        });
      });
    }); 