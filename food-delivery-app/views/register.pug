extends layout.pug

block content
  .registration-container
    h2.registration-form-title Register

    if errors && errors.length
      .alert.alert-danger
        h3 Please fix the following errors:
        ul
          each error in errors
            li= error

    form.registration-form(action="/register", method="POST")
      .form-group
        label(for="phoneNumber") phoneNumber
        input(type="tel", id="phoneNumber", name="phoneNumber", required)
      .form-group
        label(for="fname") First Name
        input(
          type="text",
          id="fname",
          name="fname",
          required,
          value=formData ? formData.fname : ''
        )

      .form-group
        label(for="lname") Last Name
        input(
          type="text",
          id="lname",
          name="lname",
          required,
          value=formData ? formData.lname : ''
        )

      .form-group
        label(for="username") Username
        input(
          type="text",
          id="username",
          name="username",
          required,
          value=formData ? formData.username : ''
        )
      .form-group.password-group
        label(for="password") Password
        .password-input-container
          input(
            type="password",
            id="password",
            name="password",
            required,
            class="password-field"
          )
          button.toggle-password(type="button") 👁️
        .password-requirements
          strong Password Requirements:
          ul
            li Minimum #{passwordRules.minLength} characters
            if passwordRules.requireUppercase
              li At least one uppercase letter (A-Z)
            if passwordRules.requireLowercase
              li At least one lowercase letter (a-z)
            if passwordRules.requireNumbers
              li At least one number (0-9)
            if passwordRules.requireSpecialChars
              li At least one special character (!@#$%^&*)

      .form-group
        label(for="account_type") Account Type
        select(id="account_type", name="account_type", required)
          option(value="", disabled, selected=!formData || !formData.account_type) Select account type
          option(
            value="customer",
            selected=formData && formData.account_type === 'customer'
          ) Customer
          option(
            value="supplier",
            selected=formData && formData.account_type === 'supplier'
          ) Supplier

      button.button(type="submit") Register

      block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const toggleButton = document.querySelector('.toggle-password');
      const passwordField = document.querySelector('.password-field');
      
      if (toggleButton && passwordField) {
        toggleButton.addEventListener('click', function() {
          const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
          passwordField.setAttribute('type', type);
          this.textContent = type === 'password' ? '👁️' : '👁️‍🗨️';
        });
      }
    });