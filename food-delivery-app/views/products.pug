extends layout

block content
  h1 All Products

  if products.length
    ul.product-list
      each product in products
        li.product-item
          h2 
            a(href=`/product/${product.product_id}`) #{product.name}
          p Supplier: #{product.supplier_fname} #{product.supplier_lname}
          p Price: $#{product.price}
          p Uploaded: #{product.upload_date.toDateString()}
          p= product.description
          hr
  else
    p No products found.
